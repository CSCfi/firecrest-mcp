{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "firecrest-lumi": {
            "type": "local",
            "command": ["uvx", "firecrest-mcp"],
            "enabled": true,
            "environment": {
                "FIRECREST_URL": "https://api.lumi.csc.fi/v1"
            }
        },
        "firecrest-roihu": {
            "type": "local",
            "command": ["uvx", "firecrest-mcp"],
            "enabled": true,
            "environment": {
                "FIRECREST_URL": "https://api.roihu.csc.fi/v1"
            }
        }
    }
}
