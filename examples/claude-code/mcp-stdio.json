  "mcpServers": {
    "firecrest-lumi": {
      "type": "stdio",
      "command": "firecrest-mcp",
      "env": {
        "FIRECREST_URL": "https://api.lumi.csc.fi/v1"
      }
    },
    "firecrest-roihu": {
      "type": "stdio",
